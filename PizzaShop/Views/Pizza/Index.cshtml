@using PizzaShop.ViewModels.PizzaVM

@model PizzaListViewModel

@{
    ViewData["Title"] = "Pizza Shop";
}
<h1>@ViewData["Title"]</h1>
<br />

@foreach (var item in Model.Items)
{
    <a asp-controller="Pizza"
    asp-action="Details" 
    asp-route-id="@item.PizzaId">@item.PizzaName</a>
    <br />
}