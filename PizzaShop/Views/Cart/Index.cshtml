@using PizzaShop.ViewModels.CartVM

@model CartViewModel

<h1>Cart</h1>
<br />

@if (!Model.Items.Any())
{
    <p>Your cart is empty</p>
}
else
{
    foreach(var item in Model.Items)
    {
        <p>@item.PizzaName</p>
        <p>Price: @item.Price</p>
        <form asp-controller="Cart"
            asp-action="Update"
            method="post">

            <input type="hidden" 
                name="PizzaId"
                value=@item.PizzaId />
            <input type="number"
                name="Quantity"
                value="@item.Quantity" 
                min="1"
                max="20" />

            <button type="submit">
                Update
            </button>
        </form>
        <form asp-controller="Cart"
            asp-action="Remove"
            method="post">

            <input type="hidden"
                name="pizzaId"
                value="@item.PizzaId" />

            <button type="submit">
                Remove
            </button>
        </form>
        <p>Total: @item.Total</p>
        <br />
    }
}

<hr />
<p>Total: @Model.Total</p>
