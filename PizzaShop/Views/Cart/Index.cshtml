@using PizzaShop.ViewModels.CartVM

@model CartViewModel

<h1>Cart</h1>
<br />

@if (!Model.Items.Any())
{
    <p>Your cart is empty</p>
}
else
{
    foreach(var item in Model.Items)
    {
        <p>@item.PizzaName</p>
        <p>Price: @item.Price</p>
        <p>Quantity: @item.Quantity</p>
        <p>Total: @item.Total</p>
        <br />
    }
}

<hr />
<p>Total: @Model.Total</p>
